@startuml UC07_XemTaiLieuAPI
skinparam SequenceArrowColor #64748B
skinparam SequenceBoxBorderColor #CBD5E1
skinparam ParticipantBackgroundColor #F8FAFC
skinparam ParticipantBorderColor #94A3B8

title UC07 — Xem tài liệu API

actor "Người dùng" as User
participant "Frontend\n(/swagger — Server Component)" as FE
participant "File System" as FS

User -> FE: Truy cập trang /swagger
FE -> FS: Đọc dist/openapi-bundled.yaml\n(trực tiếp, không qua Backend)

alt Bundle chưa tồn tại
  FS --> FE: File not found
  FE --> User: Hiển thị "Chưa có bundle OpenAPI\nChạy build tài liệu từ Dashboard trước"
else Bundle tồn tại
  FS --> FE: YAML content
  FE -> FE: Khởi tạo Swagger UI\nvới Fuse.js plugin
  FE --> User: Render danh sách endpoint\n(method, path, summary, description)
end

opt Người dùng tìm kiếm
  User -> FE: Nhập từ khóa vào ô search
  FE -> FE: Fuse.js fuzzy search\n(operationId, path, summary, description)
  FE --> User: Hiển thị kết quả\ntheo độ liên quan
end

User -> FE: Bấm vào endpoint
FE --> User: Mở rộng chi tiết:\nparameters, request body,\nresponse schema, error codes

@enduml
