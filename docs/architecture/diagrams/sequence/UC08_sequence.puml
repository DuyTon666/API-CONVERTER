@startuml UC08_EnrichMetadataAPI
skinparam SequenceArrowColor #64748B
skinparam SequenceBoxBorderColor #CBD5E1
skinparam ParticipantBackgroundColor #F8FAFC
skinparam ParticipantBorderColor #94A3B8

title UC08 — Enrich metadata API (Claude AI)

participant "Pipeline" as PL
participant "Claude AI\n(claude-sonnet-4-6)" as AI
participant "File System" as FS

PL -> PL: Chuẩn bị prompt\ntừ ParsedOperation\n(method, path, parameters,\nrequest/response body)

alt ANTHROPIC_API_KEY chưa cấu hình
  PL -> PL: Fallback: sinh operationId\nrule-based (method + path)
  PL -> FS: Ghi vào human_review_queue.json
else API key hợp lệ
  PL -> AI: POST /messages\n{ model, prompt }

  alt Claude AI phản hồi thành công
    AI --> PL: { summary, operationId, description }
    PL -> PL: Validate định dạng response

    alt Response đúng định dạng
      PL -> PL: Gắn metadata\nvào ParsedOperation
    else Response sai định dạng
      PL -> PL: Fallback: rule-based operationId
      PL -> FS: Ghi vào human_review_queue.json
    end

  else Claude AI thất bại / timeout
    AI --> PL: Error / No response
    PL -> PL: Fallback: rule-based operationId
    PL -> FS: Ghi vào human_review_queue.json
  end
end

@enduml
