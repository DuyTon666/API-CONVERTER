@startuml UC05_ChinhSuaDuyetNoiDung
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityBorderColor #94A3B8
skinparam ArrowColor #64748B
skinparam ActivityDiamondBackgroundColor #FEF9C3
skinparam ActivityStartColor #4F46E5
skinparam ActivityEndColor #4F46E5
skinparam SwimlaneBorderColor #CBD5E1

title UC05 — Chỉnh sửa & duyệt nội dung

|Người dùng|
start
:Mở Bundle Editor cho 1 module;

if (Chọn tab nào?) then (Chỉnh sửa nội dung)
  :Mở operation muốn sửa\n(Form Editor);
  |Hệ thống|
  :Đọc summary/description/parameter/\nschema field description;
  |Người dùng|
  :Sửa nội dung, bấm Lưu;
  |Hệ thống|
  :Ghi field + marker\nx-manual-edit-fields vào tầng 2;
  :Ghi field tương ứng vào tầng 3\n(đồng bộ 2 tầng);
else (YAML thô)
  |Hệ thống|
  :Đọc toàn bộ nội dung bundle (tầng 3);
  |Người dùng|
  :Sửa trực tiếp trong Monaco Editor\nbấm Lưu;
  |Hệ thống|
  if (YAML hợp lệ?) then (Không)
    :400 BUNDLE_INVALID_YAML\nKhông ghi gì;
    stop
  else (Có)
    :Diff & ghi field thay đổi\n+ marker field-path vào tầng 2;
    :Ghi verbatim vào tầng 3\n(giữ format gốc);
  endif
endif

|Người dùng|
if (Có xung đột sửa tay khi import lại?) then (Có)
  :Mở "Xung đột sửa tay khi import lại";
  |Hệ thống|
  :Hiển thị operationId/field/\ngiá trị cũ/giá trị mới;
  |Người dùng|
  if (Chọn phương án?) then (Giữ bản cũ)
    |Hệ thống|
    :Ghi lại old_value\nvào tầng 2 + tầng 3;
  else (Lấy bản mới)
    |Hệ thống|
    :Không đổi gì\nchỉ xóa entry khỏi hàng đợi;
  endif
else (Không)
endif

stop
@enduml
