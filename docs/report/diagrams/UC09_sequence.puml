@startuml UC09_BundleYAML_Seq
skinparam SequenceArrowColor #64748B
skinparam SequenceBoxBorderColor #CBD5E1
skinparam ParticipantBackgroundColor #F8FAFC
skinparam ParticipantBorderColor #94A3B8

title UC09 — Bundle toàn bộ YAML thành 1 file (Redocly)

participant "Backend" as BE
participant "Redocly CLI" as Redocly
participant "File System" as FS

BE -> Redocly: subprocess.run(\n"redocly bundle openapi/openapi.yaml"\n)

Redocly -> FS: Đọc file entry point
FS --> Redocly: openapi.yaml

Redocly -> Redocly: Duyệt toàn bộ $ref

alt $ref trỏ đến file không tồn tại
  Redocly --> BE: exit 1\n{ error: "$ref broken" }
  BE -> BE: Ghi nhận lỗi\nBáo cáo lên giao diện
else Tất cả $ref hợp lệ
  Redocly -> Redocly: Giải quyết và nội tuyến hóa\ncác tham chiếu nội bộ
  Redocly -> FS: Ghi dist/openapi-bundled.yaml
  FS --> Redocly: OK
  Redocly --> BE: exit 0
  BE -> BE: Tiếp tục sang bước lint
end

@enduml
