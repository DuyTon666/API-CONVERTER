@startuml UC04_activity
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityBorderColor #94A3B8
skinparam ArrowColor #64748B
skinparam ActivityDiamondBackgroundColor #FEF9C3
skinparam ActivityStartColor #4F46E5
skinparam ActivityEndColor #4F46E5
skinparam SwimlaneBorderColor #CBD5E1

title UC04 — Import module

|Người dùng|
start
:Bấm "Import tất cả"\nhoặc "Import" module cụ thể;

|Hệ thống|
if (Có module active?) then (Không)
  :Nút Import bị disable /\ntrả lỗi NO_ACTIVE_MODULE;
  stop
else (Có)
endif

:Tạo job_id, giao ThreadPoolExecutor\nchạy nền, trả lời ngay;

|Người dùng|
:Mở kết nối SSE theo job_id;

|Hệ thống|
while (Còn module active chưa xử lý?) is (Có)
  :Backup tầng 2 hiện tại\n→ 3.build/backups/;
  :Capture giá trị đã sửa tay\n(_scan_manual_edits);

  while (Còn file trong module?) is (Có)
    if (Hash file thay đổi?) then (Không)
      :Bỏ qua file (skipped);
    else (Có)
      :Parse file → ParsedOperation;
      if (Parse thành công?) then (Không)
        :Ghi lỗi batch_log.json\nĐánh dấu file "error";
      else (Có)
        if (Claude AI phản hồi?) then (Không)
          :Fallback rule-based operationId\nĐánh dấu human_review_queue.json;
        else (Có)
          :Sinh summary/operationId/description;
        endif
        :Generate YAML → Post-process;
      endif
    endif
  endwhile (Không)

  :So sánh capture cũ vs file mới\n→ ghi manual_edit_conflicts.json nếu lệch;
  :Cập nhật module_registry.yaml\n(last_import_at, endpoint_count);
  :Phát 1 sự kiện SSE cho module này\n(status, success, failed, skipped);
endwhile (Không)

:Phát SSE event "done";

|Người dùng|
:Xem tiến trình & tổng kết;

stop
@enduml
