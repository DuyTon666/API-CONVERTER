@startuml UC09_BundleYAML
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityBorderColor #94A3B8
skinparam ArrowColor #64748B
skinparam ActivityDiamondBackgroundColor #FEF9C3
skinparam ActivityStartColor #4F46E5
skinparam ActivityEndColor #4F46E5

title UC09 — Bundle toàn bộ YAML thành 1 file

|Backend|
start
:Gọi lệnh\nredocly bundle openapi/openapi.yaml;

|Redocly|
:Đọc file entry point;
:Duyệt toàn bộ $ref;

if ($ref hợp lệ?) then (Không)
  |Backend|
  :Ghi nhận lỗi $ref broken\nBáo cáo lên giao diện;
  stop
else (Có)
endif

:Giải quyết và nội tuyến hóa\ncác tham chiếu nội bộ;
:Ghi kết quả ra\ndist/openapi-bundled.yaml;

|Backend|
:Nhận exit code 0\nTiếp tục sang bước lint;

stop
@enduml
