{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "x-side-effects extension schema",
  "type": "object",
  "required": ["schema_version", "meta", "effects", "review"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.1"]
    },
    "meta": {
      "type": "object",
      "required": ["detected_by", "confidence", "review_status", "last_updated"],
      "additionalProperties": false,
      "properties": {
        "detected_by": {
          "type": "string",
          "enum": ["rule_based", "claude_classifier", "manual"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_status": {
          "type": "string",
          "enum": ["pending", "confirmed", "rejected"]
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["effect_id", "source", "type", "trigger", "target", "description", "confirmed", "evidence"],
        "additionalProperties": false,
        "properties": {
          "effect_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "source": {
            "type": "string",
            "enum": ["rule_based", "manual_override", "human_review"]
          },
          "type": {
            "type": "string",
            "enum": ["state_change", "write", "notification", "async_job"]
          },
          "trigger": {
            "type": "string",
            "enum": ["always", "on_success", "on_failure"]
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entity": {"type": ["string", "null"]},
              "field": {"type": ["string", "null"]},
              "from": {"type": ["string", "null"]},
              "to": {"type": ["string", "null"]}
            }
          },
          "channel": {
            "type": ["string", "null"],
            "enum": ["email", "sms", "push", "telegram", null]
          },
          "description": {
            "type": ["string", "null"]
          },
          "confirmed": {
            "type": "boolean"
          },
          "reviewed_by": {
            "type": ["string", "null"]
          },
          "reviewed_at": {
            "type": ["string", "null"],
            "format": "date"
          },
          "evidence": {
            "type": "object",
            "required": ["source"],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": ["path", "filename", "operation_id", "module", "rule", "section_6", "manual"]
              },
              "matched_keyword": {"type": ["string", "null"]},
              "rule_id": {"type": ["string", "null"]},
              "resource_source": {"type": ["string", "null"]},
              "template_index": {"type": ["integer", "null"]},
              "extracted_from": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["required", "reason"],
      "additionalProperties": false,
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": "string"},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}