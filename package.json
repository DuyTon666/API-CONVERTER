{
  "name": "test-spectral",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint:spectral": "spectral lint dist/openapi-bundled.yaml --ruleset .spectral.yaml --format json",
    "lint": "spectral lint dist/openapi-bundled.yaml --ruleset .spectral.yaml",
    "validate:api": "redocly lint dist/openapi-bundled.yaml --config redocly.yaml --format json",
    "validate": "redocly lint dist/openapi-bundled.yaml --config redocly.yaml",
    "bundle:api": "redocly bundle 5.openapi/openapi.yaml -o dist/openapi-bundled.yaml",
    "build:docs": "node scripts/build-swagger-ui.js",
    "build:docs:redocly": "redocly build-docs dist/openapi-bundled.yaml --output public/api-docs-redocly.html",
    "scan": "python3 2.pipeline/run_api_import.py scan",
    "suggest:module": "python3 2.pipeline/run_api_import.py suggest-root",
    "review:suggest": "python3 2.pipeline/run_api_import.py review-suggestions",
    "approve": "python3 2.pipeline/run_api_import.py approve-suggestions --all",
    "update:registry": "python3 2.pipeline/run_api_import.py apply-suggestions",
    "approve:module:rule": "python3 2.pipeline/run_api_import.py approve-module-rule",
    "list:module": "python3 2.pipeline/run_api_import.py list-modules",
    "endpoints:duplicates": "python3 2.pipeline/import_flow/endpoint_duplicates.py",
    "activate:module": "python3 2.pipeline/run_api_import.py activate-module",

    "convert:api": "python3 2.pipeline/run_api_import.py import",

    "errors:parse": "python3 2.pipeline/run_api_import.py parse-errors",
    "errors:conflicts": "python3 2.pipeline/contract_profile/error_conflicts.py",
    "errors:review": "python3 2.pipeline/contract_profile/error_review_assistant.py",
    "errors:resolve": "python3 2.pipeline/run_api_import.py resolve",
    "errors:apply": "python3 2.pipeline/run_api_import.py apply-errors",
    "errors:audit:global": "python3 2.pipeline/run_api_import.py audit-global-usage",
    "errors:build-map": "python3 2.pipeline/run_api_import.py build-operation-map",
    "errors:enrich": "python3 2.pipeline/run_api_import.py enrich-errors",
    "enrich:errors": "python3 2.pipeline/run_api_import.py enrich-errors",

    "gen:path-stubs": "python3 6.path_stub/generate_path_stubs.py",
    "merge:openapi": "python3 6.path_stub/generate_path_stubs.py --merge",

    "verify:stats": "python3 2.pipeline/run_api_import.py list-modules",
    "verify:py:errors": "python3 -m py_compile 2.pipeline/contract_profile/run_error_parser.py 2.pipeline/contract_profile/operation_map_builder.py 2.pipeline/enrichers/enrich_errors.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dinh-Nhan/CI-CD.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Dinh-Nhan/CI-CD/issues"
  },
  "homepage": "https://github.com/Dinh-Nhan/CI-CD#readme",
  "devDependencies": {
    "@redocly/cli": "^2.31.2",
    "@stoplight/spectral-cli": "^6.15.1",
    "swagger-ui-dist": "^5.11.0"
  }
}